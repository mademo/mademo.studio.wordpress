# Copiez ce fichier vers .env.local, puis adaptez les valeurs à votre site Local.
# Les guillemets sont nécessaires lorsque le chemin contient des espaces.
MADEMO_WP_ROOT="/Users/mademo/Library/Application Support/Local/sites/mademo-studio/app/public"
MADEMO_WP_URL="http://mademo-studio.local"

# Lancez les commandes depuis « Open Site Shell » dans Local pour disposer de wp.
MADEMO_WP_CLI="wp"

# Mettre à 1 uniquement pour travailler hors ligne. Les vérifications de fichiers
# et de WP-CLI restent actives.
MADEMO_SKIP_HTTP_CHECK="0"
